<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="17.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Aspire runs through its CLI; the build fetches the matching one with dnx. -->
    <AspireCliInvocationMode>DnxPinned</AspireCliInvocationMode>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>1b2e5858-82b7-4d3d-8596-ad1052386103</UserSecretsId>
  </PropertyGroup>

</Project>
