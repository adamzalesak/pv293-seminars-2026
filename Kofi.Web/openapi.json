                        ],
                        "format": "double"
                    },
                    "stockQuantity": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "roastedOn": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "format": "date"
                    },
                    "origin": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "imageUrl": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "CreateProductResponse": {
                "required": [
                    "id",
                    "name"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    }
