// KoFI — architecture model (LikeC4)
//
// As-is. Drawn on design day as a proposal, then held up against four months
// of code and it survived: the API is one container, joined in seminar 2 by
// the web front end. Level 3 moved for the first time in seminar 4, when the
// domain project arrived (ADR-0006), followed by the complete Clean refactor.
//
// Preview:  npx likec4 start
// Export:   npx likec4 export png -o docs/architecture/

specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element externalSystem {
    style {
      color muted
    }
  }
  element container
  element component
}

model {
  customer = actor 'Customer' {
    description 'Browses the catalog and places orders'
  }

  operator = actor 'Shop operator' {
    description 'Maintains the catalog and handles orders'
  }

  kofi = system 'KoFI' {
    description 'E-shop: catalog, orders, subscriptions, stock, customer e-mails'

    api = container 'Kofi' {
      technology 'ASP.NET Core 10'
      description 'REST API and all business logic'

      // --- Level 3: the inside of the container ---
      // Ordering is extracted; Product and Subscriptions remain in the Clean projects.
      apiProject = component 'Kofi' {
        technology 'ASP.NET Core'
        description 'Remaining HTTP endpoints, composition root, product/stock adapters and shared transaction'
      }
      businessProject = component 'Kofi.Application' {
        technology 'C# class library'
        description 'Remaining product and subscription use cases'
      }
      dataProject = component 'Kofi.Infrastructure' {
        technology 'EF Core'
        description 'Product and subscription persistence, public tables'
      }
      domainProject = component 'Kofi.Domain' {
        technology 'C# class library, no infrastructure'
        description 'Product and Subscription models and rules'
      }

      ordering = component 'Kofi.Ordering' {
        technology 'C# / EF Core'
        description 'API, Application, Domain and Infrastructure; owns orders and customers in public tables'
      }
      orderingContracts = component 'Kofi.Ordering.Contracts' {
        technology 'Interfaces and plain DTOs'
        description 'CreateOrder, customer and order-status queries'
      }
      common = component 'Kofi.Common' {
        technology 'C# class library'
        description 'Technical request, domain-event and aggregate abstractions; no EF'
      }
      apiProject -> ordering 'composes'
      ordering -> orderingContracts 'implements'
      businessProject -> orderingContracts 'requests orders and customer information'
      ordering -> common 'references'
      businessProject -> common 'references'
      domainProject -> common 'references'

      apiProject -> businessProject 'references'
      apiProject -> dataProject 'references'
      dataProject -> businessProject 'implements ports from'
      businessProject -> domainProject 'references'
      dataProject -> domainProject 'references'
    }

    // Added in seminar 2: the shop got a web front end. It runs in the
    // browser, apart from the API, so it is a container of its own.
    web = container 'Kofi.Web' {
      technology 'React, TypeScript'
      description 'The shop and its administration, in the browser'
      style {
        shape browser
      }
    }

    web -> api 'calls' 'JSON over HTTPS'

    db = container 'Database' {
      technology 'PostgreSQL 17'
      description 'Products, orders, customers, subscriptions, deliveries'
      style {
        shape cylinder
      }
    }

    dataProject -> db 'products and subscriptions' 'SQL (EF Core)'
    ordering -> db 'orders and customers' 'SQL (EF Core)'
  }

  paymentGateway = externalSystem 'Payment gateway' {
    description 'Card payments — someone else runs it'
  }

  mailServer = externalSystem 'Mail server' {
    description 'Transactional e-mails'
  }

  customer -> web 'browses, orders, pays, manages subscriptions' 'HTTPS'
  operator -> web 'manages catalog and orders' 'HTTPS'
  api -> paymentGateway 'charges the card' 'HTTPS'
  api -> mailServer 'sends confirmations' 'SMTP'
}

views {
  view index {
    title 'KoFI — system context (C4 L1)'
    include customer, operator, kofi, paymentGateway, mailServer
  }

  view containers of kofi {
    title 'KoFI — containers (C4 L2)'
    include *
    autoLayout LeftRight
  }

  view insideApi of api {
    title 'KoFI — components inside the container (C4 L3, first module per ADR-0008)'
    include *
  }
}
