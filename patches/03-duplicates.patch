+using Wolverine.Attributes;
+
+namespace Kofi.Ordering.Application.Payments;
+
+// The provider's webhook, taken in. EventId is the provider's own id for the
+// notification, so a webhook it sends again is recognised as the same one.
+public record PaymentResultReceived(
+    [property: DeduplicationIdentity] Guid EventId,
+    Guid PaymentId,
+    Guid OrderId,
+    string Status);
diff --git a/Kofi.Ordering/Application/Payments/PaymentResultReceivedHandler.cs b/Kofi.Ordering/Application/Payments/PaymentResultReceivedHandler.cs
new file mode 100644
index 0000000..e4f2f3d
--- /dev/null
+++ b/Kofi.Ordering/Application/Payments/PaymentResultReceivedHandler.cs
@@ -0,0 +1,29 @@
+using Kofi.Common.Services;
+using Kofi.Ordering.Application.Repositories;
+using Wolverine.Attributes;
+
+namespace Kofi.Ordering.Application.Payments;
+
+// The same webhook delivered twice runs once ([Deduplicated] on EventId); the
+// same result reaching us by webhook and by redirect is caught by the order's
+// own state.
+[Deduplicated]
+public class PaymentResultReceivedHandler(IOrderRepository orders, IPaymentGatewayClient payments)
+{
+    public async Task Handle(PaymentResultReceived result, CancellationToken ct)
+    {
+        var order = await orders.GetById(result.OrderId);
+
+        // A payment for an order the shop never saved, e.g. a declined
+        // subscription charge: nothing to confirm.
+        if (order == null || order.PaymentId != result.PaymentId)
+        {
+            return;
+        }
+
+        if (order.AcceptPaymentResult(result.PaymentId, result.Status == nameof(PaymentStatus.Captured)))
+        {
+            await payments.CancelOrRefund(result.PaymentId);
+        }
+    }
+}
